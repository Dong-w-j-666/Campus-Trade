# 复制为 .env.production，并替换所有 replace-with-* 值。
# 推荐直接运行 ./scripts/setup-production-env.sh 自动生成随机密码。
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=campus_trade
DB_USERNAME=campus_app
DB_PASSWORD=replace-with-a-strong-app-password
APP_AUTH_SECRET=replace-with-at-least-32-random-characters

# 未配置域名和 HTTPS 时，可通过公网 IP:8080 做临时验收。
APP_BIND_ADDRESS=0.0.0.0
APP_HOST_PORT=8080
APP_SECURE_COOKIE=false
